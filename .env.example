# ── Environment Configuration ──────────────────────────────────
# Copy this file to .env and customize values

# Database (SQLite — no external server needed)
DATABASE_URL=sqlite:///./menu.db

# JWT Secret Key (change this in production!)
SECRET_KEY=smart-menu-secret-key-change-in-production-2024

# Ollama AI (optional — app works without it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend URL (for CORS and QR code generation)
FRONTEND_URL=http://localhost:5173
