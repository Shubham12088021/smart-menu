# ── Production Environment Configuration ──────────────────────
# Use these values when deploying to Render/Railway

# Database (PostgreSQL — provided by Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret Key (generate a random 64-char string)
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend URL (your Vercel deployment URL — update after deploying)
FRONTEND_URL=https://your-app.vercel.app
